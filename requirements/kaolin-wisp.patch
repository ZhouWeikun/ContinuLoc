+class SimpleAttrDict(dict):
+    """A simple, dependency-free, drop-in replacement for the core
+    functionality of the abandoned 'attrdict' package.
+    Allows accessing dictionary keys as attributes (obj.key for obj['key']).
+    """
+    def __getattr__(self, name):
+        try:
+            return self[name]
+        except KeyError:
+            raise AttributeError(f"'{type(self).__name__}' object has no attribute '{name}'")
+
+    def __setattr__(self, name, value):
+        self[name] = value
+
+    def __delattr__(self, name):
+        try:
+            del self[name]
+        except KeyError:
+            raise AttributeError(f"'{type(self).__name__}' object has no attribute '{name}'")
